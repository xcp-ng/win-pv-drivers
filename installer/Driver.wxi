<?xml version="1.0" encoding="utf-8"?>
<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?include Include.wxi ?>

  <?ifdef $(XenComponentInstalledGuid) ?>
  <Component
    Id="$(XenDriver)ComponentInstalled"
    Directory="INSTALLFOLDER"
    Guid="$(XenComponentInstalledGuid)"
    Location="local">
    <RegistryValue
      Root="HKLM"
      Key="SOFTWARE\$(VENDOR_KEY)\Components"
      Name="$(XenDriver)"
      Type="integer"
      Value="1"
      KeyPath="yes" />
  </Component>
  <?endif ?>

  <DirectoryRef Id="INSTALLFOLDER">
    <Directory Id="$(XenDriver)Dir" Name="$(XenDriver)" />
  </DirectoryRef>

  <CustomAction
    Id="$(XenDriver)Install"
    BinaryRef="xeninst.dll"
    DllEntry="DriverInstall"
    Execute="deferred"
    Impersonate="no" />
  <CustomAction
    Id="$(XenDriver)InstallRollback"
    BinaryRef="xeninst.dll"
    DllEntry="DriverInstallRollback"
    Execute="rollback"
    Impersonate="no" />
  <CustomAction
    Id="$(XenDriver)Uninstall"
    BinaryRef="xeninst.dll"
    DllEntry="DriverUninstall"
    Execute="deferred"
    Impersonate="no" />
  <CustomAction
    Id="$(XenDriver)UninstallRollback"
    BinaryRef="xeninst.dll"
    DllEntry="DriverUninstallRollback"
    Execute="rollback"
    Impersonate="no" />

  <SetProperty
    Id="$(XenDriver)Install"
    Value="Driver=$(XenDriver);Inf=[#$(XenDriver).inf]"
    After="CostFinalize"
    Sequence="execute"
    Condition="(NOT XEN_SKIP_CA) AND ($$$(XenDriver)ComponentInstalled=3)" />
  <SetProperty
    Id="$(XenDriver)InstallRollback"
    Value="Driver=$(XenDriver);Inf=[#$(XenDriver).inf]"
    After="CostFinalize"
    Sequence="execute"
    Condition="(NOT XEN_SKIP_CA) AND ($$$(XenDriver)ComponentInstalled=3)" />
  <SetProperty
    Id="$(XenDriver)Uninstall"
    Value="Driver=$(XenDriver);Inf=[#$(XenDriver).inf]"
    After="CostFinalize"
    Sequence="execute"
    Condition="(NOT XEN_SKIP_CA) AND ($$$(XenDriver)ComponentInstalled=2)" />
  <SetProperty
    Id="$(XenDriver)UninstallRollback"
    Value="Driver=$(XenDriver);Inf=[#$(XenDriver).inf]"
    After="CostFinalize"
    Sequence="execute"
    Condition="(NOT XEN_SKIP_CA) AND ($$$(XenDriver)ComponentInstalled=2)" />

  <!-- we can use the standard DeleteServices action, but we use our CA instead since we want to reuse the action in XenClean -->
  <CustomAction
    Id="$(XenDriver)ServiceDelete"
    BinaryRef="xeninst.dll"
    DllEntry="XenServiceDelete"
    Execute="deferred"
    Impersonate="no" />

  <?ifndef $(XenDriverManualInstallSequence) ?>

  <?ifdef $(XenDriverDependsOn) ?>
  <InstallExecuteSequence>
    <Custom
      Action="$(XenDriver)InstallRollback"
      After="$(XenDriverDependsOn)Install"
      Condition="(NOT XEN_SKIP_CA) AND ($$$(XenDriver)ComponentInstalled=3)" />
    <Custom
      Action="$(XenDriver)Install"
      After="$(XenDriver)InstallRollback"
      Condition="(NOT XEN_SKIP_CA) AND ($$$(XenDriver)ComponentInstalled=3)" />
    <Custom
      Action="$(XenDriver)Uninstall"
      Before="$(XenDriverDependsOn)UninstallRollback"
      Condition="(NOT XEN_SKIP_CA) AND ($$$(XenDriver)ComponentInstalled=2)" />
    <Custom
      Action="$(XenDriver)UninstallRollback"
      Before="$(XenDriver)Uninstall"
      Condition="(NOT XEN_SKIP_CA) AND ($$$(XenDriver)ComponentInstalled=2)" />
    <Custom
      Action="$(XenDriver)ServiceDelete"
      Before="$(XenDriverDependsOn)ServiceDelete"
      Condition="(NOT XEN_SKIP_CA) AND ($$$(XenDriver)ComponentInstalled=2) AND ($(XenDriver)ServiceDelete)" />
  </InstallExecuteSequence>
  <?else ?>
  <InstallExecuteSequence>
    <Custom
      Action="$(XenDriver)InstallRollback"
      After="InstallFiles"
      Condition="(NOT XEN_SKIP_CA) AND ($$$(XenDriver)ComponentInstalled=3)" />
    <Custom
      Action="$(XenDriver)Install"
      After="$(XenDriver)InstallRollback"
      Condition="(NOT XEN_SKIP_CA) AND ($$$(XenDriver)ComponentInstalled=3)" />
    <Custom
      Action="$(XenDriver)UninstallRollback"
      After="DeleteServices"
      Condition="(NOT XEN_SKIP_CA) AND ($$$(XenDriver)ComponentInstalled=2)" />
    <Custom
      Action="$(XenDriver)Uninstall"
      After="$(XenDriver)UninstallRollback"
      Condition="(NOT XEN_SKIP_CA) AND ($$$(XenDriver)ComponentInstalled=2)" />
    <Custom
      Action="$(XenDriver)ServiceDelete"
      Before="RemoveFiles"
      Condition="(NOT XEN_SKIP_CA) AND ($$$(XenDriver)ComponentInstalled=2) AND ($(XenDriver)ServiceDelete)" />
  </InstallExecuteSequence>
  <?endif ?>

  <!-- setting the template doesn't work in either ProgressText or ActionStart[3] and I don't know why -->
  <UI>
    <ProgressText Action="$(XenDriver)Install" Message="!(loc.DriverInstallText)" Template="!(loc.DriverInstallTemplate)" />
    <ProgressText Action="$(XenDriver)Uninstall" Message="!(loc.DriverUninstallText)" Template="!(loc.DriverUninstallTemplate)" />
  </UI>

  <?endif ?>

  <?ifdef $(XenDriverUpgradeNeedsReboot) ?>
  <SetProperty
    Id="XenNeedsReboot"
    Action="$(XenDriver)NeedsReboot"
    Value="1"
    Before="InstallFinalize"
    Sequence="execute"
    Condition="(NOT XEN_SKIP_CA) AND (($$$(XenDriver)ComponentInstalled=2) OR ($$$(XenDriver)ComponentInstalled=3))" />
  <?endif ?>
</Include>
