<?xml version="1.0" encoding="utf-8"?>
<!--
This file contains the declaration of all the localizable strings.
-->
<WixLocalization xmlns="http://wixtoolset.org/schemas/v4/wxl" Culture="en-US">
  <?include Include.wxi ?>

  <String Id="GenericProductName" Value="Windows Guest Tools" />
  <String Id="ProductName" Value="$(VENDOR_NAME) Windows Guest Tools" />

  <String Id="XenSkipCANotAllowedHere" Value="XEN_SKIP_CA can only be used for uninstallation." />

  <String Id="MachineIsX64Error" Value="Please install the 64-bit version of this package on 64-bit systems." />

  <String Id="NetFx462RequiredError" Value="[ProductName] requires .NET 4.6.2 or later." />

  <String Id="OldDriversDetectedError" Value="Old Xen PV drivers detected. Uninstall them before continuing.
You may need to run the XenClean tool." />
  <String Id="CitrixDriversDetectedError" Value="Citrix PV drivers detected. Uninstall them before continuing." />
  <String Id="DowngradeError" Value="A newer version of [ProductName] is already installed." />
  <String Id="UnsupportedUpgradeError" Value="Cannot upgrade from your current version of [ProductName]. Try upgrading to an older version first." />
  <String Id="Unpatched350UpgradeError" Value="Upgrade from 9.2.350 is blocked. Apply the 9.2.351 compatibility update before installing this release." />

  <String Id="WelcomeDlgDescription" Overridable="yes" Value="The Setup Wizard will install [ProductName] on your computer. Click Next to continue or Cancel to exit the Setup Wizard.&#13;&#10;&#13;&#10;Notice: Installing [ProductName] may temporarily interrupt network connectivity." />
  <String Id="WelcomeUpdateDlgDescriptionUpdate" Overridable="yes" Value="The Setup Wizard will update [ProductName] on your computer. Click Next to continue or Cancel to exit the Setup Wizard.&#13;&#10;&#13;&#10;Notice: Updating [ProductName] may temporarily interrupt network connectivity." />
  <String Id="MaintenanceWelcomeDlgDescription" Overridable="yes" Value="The Setup Wizard allows you to change the way [ProductName] features are installed on your computer or to remove it from your computer. Click Next to continue or Cancel to exit the Setup Wizard.&#13;&#10;&#13;&#10;Notice: Changing, repairing or removing [ProductName] may temporarily interrupt network connectivity." />

  <String Id="FatalErrorDescription1" Overridable="yes" Value="[ProductName] Setup Wizard ended prematurely because of an error. To protect system operation, all Xen PV drivers have been removed. To install this program at a later time, run Setup Wizard again." />
</WixLocalization>
