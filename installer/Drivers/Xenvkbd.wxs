<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <?define XenDriver="Xenvkbd" ?>
    <?define XenComponentInstalledGuid="{78EB0DC1-05F8-454A-AD19-E0ED31A716FF}" ?>
    <?define XenDriverDependsOn="Xenbus" ?>
    <?include ../Driver.wxi ?>

    <ComponentGroup Id="$(XenDriver)Component" Directory="$(XenDriver)Dir" Source="!(bindpath.driver-bins)$(XenDriver)">
      <ComponentRef Id="$(XenDriver)ComponentInstalled" />
      <File Name="xenvkbd.cat" DefaultVersion="$(XenvkbdVersion)" DefaultLanguage="1033" />
      <File Name="xenvkbd.inf" Id="Xenvkbd.inf" DefaultVersion="$(XenvkbdVersion)" DefaultLanguage="1033" />
      <File Name="xenvkbd.sys" />
    </ComponentGroup>

    <SetProperty
      Id="$(XenDriver)ServiceDelete"
      Value="Services=xenvkbd"
      After="CostFinalize"
      Sequence="execute"
      Condition="NOT XEN_SKIP_CA" />
  </Fragment>
</Wix>
